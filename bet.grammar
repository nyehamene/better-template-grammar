core       = @import("core/core.grammar");
components = @import("core/component.grammar");
styles     = @import("core/style.grammar");

Bet        = { decl core.separator };
decl       = const
           | var
           | doc
           ;
const      = decl_ident ":" [ core.qual_ident ] ":" expr;
var        = decl_ident ":" [ core.qual_ident ] "=" expr
           | decl_ident ":" core.qual_ident
           ;
doc        = core.ident ":" core.string
           | core.ident ":" core.string_lines
           ;
decl_ident = core.ident;
expr       = core.expr
           | components.Component
           | styles.Style
           ;
