core       = @import("core/core.grammar");
components = @import("core/component.grammar");
styles     = @import("core/style.grammar");

Bet         = { decl core.separator };
decl        = var;
var         = core.ident ( var_type | var_default | var_doc );
var_type    = ":" core.type;
var_default = [ var_type ] ( ":" | "=" ) expr;
var_doc     = core.string
            | core.string_lines
            ;
expr        = core.expr
            | components.Component
            | styles.Style
            ;
