core = @import("core.grammar");
css  = @import("css.grammar");

// Component
Component      = "component" "{" { field core.separator } [ component_body ] "}";
component_body = element { element };
field          = core.ident ( field_type | field_initr ) [ field_tag ];
field_initr    = ( var_type | ":" ) ( ":" | "=" ) field_value;
field_type     = ":" core.type;
field_tag      = "@" core.ident "(" core.expr_list ")";
field_value    = expr
               | core.string_lines
               | core.call
               | core.size
               | core.percentage
               | core.color_hex
               ;

// Element
element           = string_element
                  | if_element
                  | cond_element
                  | component_element
                  ;
string_element    = core.string
                  | core.string_lines
                  ;
if_element        = "(" "if" expr element [ element ] ")";
cond_element      = "(" "cond" expr cond_element_case { cond_element_case } ")";
component_element = "(" component_tag [ element_model ] { children } ")";
component_tag     = core.ident
                  | core.qual_ident
                  ;
cond_element_case = basic_expr element;
element_model     = "[" ( core.ident | core.qual_ident ) "]";
children          = [ attribute_ns ] attribute_group
                  | [ attribute_ns ] inline_css
                  | element
                  ;
inline_css        = "css" [ ns_selector_group ] css.block;

// Attribute
attribute_group   = "{" [ attributes [ "," ] ] "}";
attributes        = attribute { [ "," ] attribute };
attribute         = attribute_key [ "=" attribute_value ];
attribute_ns      = "@" core.qual_ident [ ns_selector_group ];
attribute_key     = core.ident
                  | core.ident_dash
                  | attribute_key_namespaced
                  | core.string
                  ;
attribute_value   = field_value;
ns_selector_group = "[" core.string { "," ns_selector } [ "," ] "]";
ns_selector       = ":" [ ":" ] ( core.ident_dash | core.ident )
                  | core.string
                  ;

attribute_key_namespaced = core.ident ":" ( core.ident | core.ident_dash );

// Expression
expr       = basic_expr
           | core.if_expr
           | core.cond_expr
           ;
basic_expr = core.string
           | core.qual_ident
           | core.number
           | core.bool
           ;
