// Expression
expr         = primary_expr
             | builtin
             | call
             | if_expr
             | cond_expr
             | enum
             | member_access
             ;
primary_expr = "currentcolor"
             | "." ident
             | string
             | string_lines
             | bool
             | number
             | size
             | percentage
             | color_hex
             | ident
             | ident_dash
             | slice_literal
             | map_literal
             | "(" expr ")"
             ;

// Identifier
bool       = "true" | "false";
ident      = /[a-zA-Z_][a-zA-Z0-9_]*/;
ident_dash = /(--)?[a-zA-Z_-][a-zA-Z0-9_-]*/;

// Number
digit_hex  = /[a-fA-F0-9]/;
digit_bin  = "0" | "1";
integer    = /[1-9]/;
number_bin = ( "0b" | "0B" ) digit_bin { digit_bin };
number_hex = ( "0x" | "0X" ) digit_hex { digit_hex };
number_dec = "0" | integer [ "." ( "0" | integer ) ];
number     = number_dec
           | number_hex
           | number_bin
           ;

// Size and color
size       = number ident;
percentage = number "%";
color_hex  = "#" { digit_hex };

// String & String line
string               = "\"" { string_content } "\"";
string_line          = "\\" { string_content };
string_content       = escape_char
                     | string_template_expr
                     | /[^\n"]/
                     ;
string_template_expr = "\\{" primary_expr "}";
escape_char          = "\\\\"
                     | "\\\""
                     | "\\t"
                     | "\\r"
                     | "\\s"
                     | "\\f"
                     | "\\v"
                     | "\\n"
                     ;
string_lines         = string_line { string_line };

// Function call
call      = primary_expr "(" [ expr_list [ "," ] ] ")";
expr_list = expr { "," expr };

builtin        = "@" call;
member_access  = primary_expr member { member };
member         = "." ( ident | call );
if_expr        = "(" "if" expr expr [ expr ] ")";
cond_expr      = "(" "cond" expr cond_expr_case { cond_expr_case } ")";
cond_expr_case = primary_expr expr;

// Enumerations
enum         = "enum" "{" [ enum_members ] "}";
enum_members = ident { separator ident };

// Slice & Map Literals
slice_literal  = type_slice "{" [ expr_list [ "," ] ] "}";
map_literal    = type_map "{" [ map_entry_list [ "," ] ] "}";
map_entry_list = map_entry { "," map_entry };
map_entry      = expr "=" expr;

// Type
type       = ident
           | qual_ident
           | type_slice
           | type_map
           ;
qual_ident = ident "." ident { "." ident };
type_slice = "[" "]" type;
type_map   = "map" "[" type "]" type;

// Statement separator & comment
// Supports automatic semicolon insertion on newline
separator = ";";
Comment   = "//" /[^\n]*[\n]?/;
