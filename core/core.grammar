// Expression
expr         = primary_expr
             | call
             | if_expr
             | cond_expr
             | enum
             | member_access
             ;
primary_expr = string
             | string_lines
             | bool
             | number
             | ident
             | ident_dash
             | "." ident
             | size
             | percentage
             | color_hex
             | slice_literal
             | map_literal
             ;

// Identifier
bool       = "true" | "false";
ident      = /[a-zA-Z_][a-zA-Z0-9_]*/;
ident_dash = /(--)?[a-zA-Z_-][a-zA-Z0-9_-]*/;

// Number
digit_hex  = /[a-fA-F0-9]/;
digit_bin  = "0" | "1";
integer    = /[1-9]/;
number_bin = ( "0b" | "0B" ) digit_bin { digit_bin };
number_hex = ( "0x" | "0X" ) digit_hex { digit_hex };
number_dec = "0" | integer [ "." ( "0" | integer ) ];
number     = number_dec
           | number_hex
           | number_bin
           ;

// Size and color
size       = number ident;
percentage = number "%";
color_hex  = "#" { digit_hex };

// String & String line
string               = "\"" { string_content } "\"";
string_line          = "\\" { string_content };
string_content       = escape_char
                     | string_template_expr
                     | /[^\n"]/
                     ;
string_template_expr = "\\{" primary_expr "}";
escape_char          = "\\\\"
                     | "\\\""
                     | "\\t"
                     | "\\r"
                     | "\\s"
                     | "\\f"
                     | "\\v"
                     | "\\n"
                     ;
string_lines         = string { "\n" string_line };
member_access        = { selector "." } expr;
selector             = ident | call;

// Function call
call           = function_ident function_args;
function_args  = "(" [ expr { "," expr } [ "," ] ] ")";
function_ident = [ "@" ] ident;
if_expr        = "(" "if" expr expr [ expr ] ")";
cond_expr      = "(" "cond" expr cond_expr_case { cond_expr_case } ")";
cond_expr_case = primary_expr expr;

// Enumerations
enum        = "enum" "{" { enum_member } "}";
enum_member = ident separator;

// Slice & Map Literals
slice_literal = type_slice "{" {expr} "}";
map_literal = type_map "{" { expr "=" expr} "}";

// Type
type       = ident
           | qual_ident
           | type_slice
           | type_map
           ;
qual_ident = ident "." ident { "." ident };
type_slice = "[" "]" type;
type_map   = "map" "[" type "]" type;

// Separator & comment
separator = ";" | "\n" | $EOF;
Comment   = "//" /[^\n]*[\n]?/;
