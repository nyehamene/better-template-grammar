core          = @import("core.grammar");
type          = @import("type.grammar");
// Style
Style         = "style" "(" [ parameters ] ")" block;
parameters    = parameter { "," parameter } [ "," ];
parameter     = core.ident ":" type.Type { parameter_tag };
parameter_tag = "@" "var" "(" core.string [ "," core.string ] [ "," ] ")";
block         = "{" [ rules ] "}";
rules         = rule { ";" rule } [ ";" ];
rule          = property
              | comment_style
              ;
property      = ident ":" expr [ "!" "important" ];

// Expression
// ==============
expr         = term_expr { [ "," | "/" ] term_expr };
term_expr    = factor_expr { ( "-" | "+" ) factor_expr };
factor_expr  = unary_expr { ( "/" | "*" ) unary_expr };
unary_expr   = ( "!" | "-" ) unary_expr
             | call
             ;
primary_expr = core.string
             | core.bool
             | ident
             | number
             | core.size
             | core.percentage
             | core.color_hex
             | "(" expr ")"
             ;
call         = primary_expr "(" { expr } ")";
number       = core.number_dec;
ident        = core.ident
             | core.ident_dash
             ;

// Comment
comment_style = "/*" /.*/ "*/";
