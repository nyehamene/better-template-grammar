core       = @import("base/core.grammar");
components = @import("base/component.grammar");
css        = @import("base/css.grammar");

Module    = { stmt core.separator };
stmt      = decl | expr;
decl      = doc | var | import;
var       = core.ident ( var_type | var_initr );
var_type  = ":" core.type;
var_initr = ( var_type | ":" ) ( ":" | "=" ) expr;
doc       = core.ident ":" ( core.string | core.string_lines );
expr      = core.expr
          | components.Component
          | css.Rule
          ;

import       = core.ident import_type import_value;
import_type  = ":" [ "import" ];
import_value = ( ":" | "=" ) import_expr;
import_expr  = "import" "(" core.string ")";
