core       = @import("core/core.grammar");
components = @import("core/component.grammar");
css        = @import("core/css.grammar");

Module    = { ( doc | var ) } core.separator;
var       = core.ident ( var_type | var_initr );
var_type  = ":" core.type;
var_initr = ( var_type | ":" ) ( ":" | "=" ) expr;
doc       = core.ident ":" ( core.string | core.string_lines );
expr      = core.expr
          | core.builtin
          | components.Component
          | css.Rule
          ;
