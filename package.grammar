bet  = @import("module.grammar");
core = @import("core/core.grammar");

Package   = { ( doc | var | stmt ) } core.separator;
stmt      = core.call;
var       = core.ident ( var_type | var_initr );
var_type  = ":" core.type;
var_initr = ( var_type | ":" ) ( ":" | "=" ) core.expr;
doc       = core.ident ":" ( core.string | core.string_lines );
