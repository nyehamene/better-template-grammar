bet  = @import("module.grammar");
core = @import("core/core.grammar");

Package     = { stmt core.separator };
stmt        = decl
            | core.call
            ;
decl        = var;
var         = core.ident ( var_type | var_default | var_doc );
var_type    = ":" core.type;
var_default = [ var_type ] ( ":" | "=" ) core.expr;
var_doc     = core.string
            | core.string_lines
            ;
